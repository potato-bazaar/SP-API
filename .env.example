# port the server listens on (HTTP for the game + WebSocket at /ws)
PORT=8787
# comma-separated origins allowed to open a socket (empty = any; set this in production)
ALLOWED_ORIGINS=https://sniper.example.com
# max simultaneous sockets from one IP
MAX_CONN_PER_IP=12
# 1 only behind a proxy that sets X-Forwarded-For (nginx); facing the internet directly, leave it 0.
# Cloudflare needs nothing here: connections from Cloudflare's ranges are recognised and CF-Connecting-IP is used.
TRUST_PROXY=0
# Direct game socket (skips Cloudflare's routing for the game, keeps it for the website). On the Oracle server these
# live in /etc/sniper.env so deploys keep them. All optional: without a certificate there is no HTTPS listener.
# TLS_CERT=/home/opc/sniper-tls/fullchain.pem
# TLS_KEY=/home/opc/sniper-tls/key.pem
# HTTPS_PORT=443
# pages served through Cloudflare tell the client to open its socket here (a DNS-only host with the certificate above)
# GAME_WS_URL=wss://play.quicksnipergame.com/ws
# Let's Encrypt HTTP-01 webroot, served at /.well-known/acme-challenge/
# ACME_DIR=/home/opc/sniper-acme
# never set in production: enables the test-only teleport command
SC_DEV=0
