# port the server listens on (HTTP for the game + WebSocket at /ws)
PORT=8787
# comma-separated origins allowed to open a socket (empty = any; set this in production)
ALLOWED_ORIGINS=https://sniper.example.com
# max simultaneous sockets from one IP
MAX_CONN_PER_IP=12
# 1 only behind a proxy that sets X-Forwarded-For (nginx); facing the internet directly, leave it 0.
# Cloudflare needs nothing here: connections from Cloudflare's ranges are recognised and CF-Connecting-IP is used.
TRUST_PROXY=0
# never set in production: enables the test-only teleport command
SC_DEV=0
